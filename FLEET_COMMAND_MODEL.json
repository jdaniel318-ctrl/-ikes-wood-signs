{
  "schema": "dark-sky-command-model-v1",
  "build": "8.8.15.4",
  "views": {
    "operational": "professional-default",
    "presentation": "cinematic-secondary"
  },
  "layers": [
    {
      "id": "owner",
      "verb": "operate-business",
      "mission": "run the exact vessel business through standalone Owner / Partner Control without requiring Black Flag Engine"
    },
    {
      "id": "engine",
      "verb": "operate",
      "mission": "routing, diagnostics, recovery, commissioning and project health"
    },
    {
      "id": "captain",
      "verb": "command",
      "mission": "Watch → Decide → Act → Record across vessels"
    },
    {
      "id": "admiral",
      "verb": "govern",
      "mission": "fleet posture, doctrine, standards, Foundry, delegation and cross-vessel intelligence"
    }
  ],
  "learning_pipeline": [
    "Observation",
    "Lesson",
    "Capability Candidate",
    "Foundry",
    "Sea Trial",
    "Proven Capability",
    "Fleet Standard / Shared Service / New Vessel"
  ],
  "release": "Spine Surface",
  "viewContract": {
    "default": "professional",
    "cinematic": "secondary presentation over same command model",
    "statePreserved": true,
    "captain": [
      "Watch",
      "Decide",
      "Act",
      "Record"
    ],
    "admiral": [
      "Govern",
      "Standardize",
      "Delegate",
      "Promote"
    ]
  },
  "outcomeContract": {
    "readinessFindings": "durable actionable findings",
    "actionResults": "remain at affected command context",
    "whatChanged": "visible on professional command"
  },
  "presentation_contract": {
    "professional_default": true,
    "cinematic_secondary": true,
    "same_command_model": true,
    "preserve_state_across_views": true,
    "no_operational_overlays": true,
    "captain_lanes": [
      "Watch",
      "Decide",
      "Act",
      "Record"
    ],
    "admiral_lanes": [
      "Govern",
      "Standardize",
      "Delegate",
      "Promote"
    ],
    "layout_order": [
      "Command lanes",
      "Status",
      "Tools",
      "Presentation"
    ]
  },
  "readiness_truth": {
    "lifecycle": [
      "Detected",
      "Open",
      "Verified Fix",
      "Cleared"
    ],
    "current_posture_separate_from_history": true,
    "direct_actions": true,
    "storage_growth_watch": true,
    "captain_outcomes_durable": true
  },
  "admiralCourseAuthority": {
    "enabled": true,
    "authority": "admiral",
    "captainRole": "recommend-and-execute-delegated-course",
    "engineRole": "implement-current-promoted-course",
    "promotionRequired": true,
    "historyRetained": true,
    "rollbackSupported": true,
    "invariant": "Changing Fleet course must not silently rewrite prior proof, vessel identity, owner authority, or release history."
  },
  "admiralCommissioningAuthority": {
    "enabled": true,
    "authority": "admiral",
    "previewRequired": true,
    "defaultLifecycle": "commissioning",
    "commissionerBecomesOwner": false,
    "createsMembership": false,
    "createsEntitlements": false,
    "workingNameEditable": true,
    "immutableIdentity": [
      "id",
      "project_id",
      "namespace"
    ]
  },
  "fleetStructureContract": {
    "registryOwner": "black_flag",
    "topology": "lateral_independent_members",
    "roles": {
      "admiral": "govern standards, capability passage, and fleet-wide posture without absorbing vessels",
      "captain": "operate and distribute only delegated, vessel-scoped capability",
      "firstMate": "build, test, repair, and report without granting authority or crossing data boundaries"
    },
    "bootstrapBuild": {
      "missionClass": "admiral_program",
      "relationshipToOtherVessels": "peer_not_parent",
      "commissionedByThisRelease": false
    },
    "existingFleet": {
      "count": 6,
      "missionClass": "independent_business",
      "identityAndDataIsolation": true
    },
    "sharedCapabilityPassage": {
      "availableAcrossLevels": true,
      "explicitAdoptionRequired": true,
      "movesOwnership": false,
      "movesAuthority": false,
      "movesProjectData": false
    }
  },
  "admiralFirstPaint": {
    "defaultView": "professional",
    "defaultLane": "govern",
    "scrollPosition": "top",
    "backgroundReadiness": "compact-posture-only",
    "currentFindingsPublisher": "manual-fleet-readiness-only",
    "incompleteProofState": "verifying-not-hold"
  },
  "admiralRecovery": {
    "provider": "supabase-auth",
    "requestOrigin": "dark-sky-admiral-entitlement-station",
    "explicitRedirect": "root-index?surface=admiral-recovery",
    "callbackPrecedence": "before-engine-owner-preview",
    "identityResolution": [
      "auth-v1-user",
      "fleet_global_authorities-self"
    ],
    "requiredAuthority": "admiral-active-not-revoked",
    "typeMarkerRequired": false,
    "passwordStorage": "supabase-auth-only",
    "tokenPersistence": "forbidden",
    "failureMode": "safe-hold-no-authority"
  },
  "authorityGrammar": {
    "customer": "uses the vessel customer experience only",
    "owner": "operates the exact vessel business",
    "engine": "operates the platform, diagnostics, recovery and approved support tooling without silently becoming Owner",
    "captain": "commands fleet operations within delegated and vessel-scoped authority",
    "admiral": "governs fleet doctrine, capability passage, commissioning and cross-vessel posture without running vessel businesses"
  },
  "planes": {
    "controlPlane": [
      "vessel registry",
      "membership and authority",
      "capability entitlements",
      "deployments and outposts",
      "release assignments",
      "Watch health",
      "audited support leases"
    ],
    "vesselDataPlane": [
      "orders",
      "customers",
      "settings",
      "pricing",
      "business files",
      "private operating records"
    ],
    "projectionRule": "Upper command consumes safe vessel projections and events; it does not receive raw private business records by default."
  },
  "activitySpine": {
    "model": "append-only vessel-scoped events",
    "oneFactOneEvent": true,
    "requiredIdentity": [
      "vesselId",
      "outpostId when applicable",
      "actor/authority",
      "eventType/version",
      "correlationId",
      "causationId",
      "idempotencyKey"
    ],
    "runtimeSeed": "8.8.15.2 bounded non-PII local runtime journal",
    "watchtower": "projection, not source of truth",
    "recoveryLedger": "projection of the same event stream, not an independent truth store"
  },
  "releaseRings": {
    "order": [
      "proving-vessel",
      "small-ring",
      "fleet-promotion"
    ],
    "provingVessel": "ikes-wood-signs",
    "automaticFleetWidePromotion": false,
    "perVesselRollbackRequired": true
  },
  "stationIdentity": {
    "immutable": [
      "deployment/outpost id",
      "vessel id"
    ],
    "mutable": [
      "mode",
      "policy version",
      "runtime version",
      "health",
      "last heartbeat",
      "last recovery"
    ],
    "customerSession": "temporary and never replaces station identity"
  },
  "foundryGate": {
    "authority": "admiral-governed",
    "candidateState": "draft-local-until-future-event-spine",
    "pipeline": [
      "Mission Demand",
      "Scout",
      "Clearance",
      "Interface Forge",
      "Sea Trial",
      "Proven Capability",
      "Utility Dock / Standalone / Vessel Service"
    ],
    "requiredClearance": [
      "commercial-license-rights",
      "attribution",
      "upstream-identity",
      "security",
      "dependency-health",
      "privacy-data-flow",
      "maintenance-health"
    ],
    "autoPublish": false,
    "truthRule": "Fleet sells its interface, workflow, hosting, integrations, support and original additions; upstream ownership and license obligations remain explicit."
  }
}
