{
  "schema": "black-flag-field-whitespace-policy-v1",
  "build": "8.8.20.31",
  "default": "preserve unknown inputs",
  "normalization": "ECMAScript trim on ordinary field boundaries only; internal text, case and line formatting retained",
  "sql_contract": "Existing PostgreSQL publisher trims ASCII boundary spaces; browser submits canonical whitespace-free boundaries. Reply and independent read compared exactly; only null versus empty issue summary is equivalent. No SQL changes.",
  "triggers": [
    "user paste",
    "autofill replacement input",
    "user blur/change",
    "before user submit/button handler reads edited fields"
  ],
  "protected": [
    "passwords and PINs",
    "tokens and secrets",
    "sign-production wording and exact exemplars",
    "raw import/code fields",
    "readonly/disabled values",
    "stored records not being edited"
  ],
  "direct_side_effects": "No network, storage, authority, submit/change/click dispatch or automatic retry in helper",
