{
  "schema": "dark-sky-fleet-steward-v1",
  "build": "8.6.33",
  "release": "Stage Two Bridge",
  "mission": "Make recurring fleet maintenance easy to find, professional to inspect, and non-destructive by default.",
  "station": {
    "id": "fleetMaintenanceStation",
    "tools": [
      "engine-telemetry",
      "proving-ground",
      "engineering-evidence",
      "recovery-snapshot",
      "fleet-watch",
      "storage-inventory"
    ]
  },
  "diagnostic_hold": {
    "default": "off",
    "scope": "same-tab browsing-context relay",
    "recovery_hold": "optional",
    "post_login_hold": "persistent until Continue Now",
    "pre_auth_relay": "window.name same-tab relay + sessionStorage mirror",
    "auth_completion_signal": "explicit app.js Engine unlock hook",
    "auto_dismiss": "forbidden while relay is pending",
    "clear_pending_on": "Continue Now or toggle-off"
  },
  "storage_inventory": {
    "mode": "read-only",
    "classes": [
      "authoritative",
      "recovery-legacy",
      "temporary",
      "browser-managed-unknown"
    ],
    "cleanup": "not-authorized-from-fleet-steward",
    "automatic_on_maintenance_bind": true,
    "summary_position": "above-maintenance-tools",
    "details_action": "VIEW STORAGE DETAILS"
  },
  "protected_baseline": "8.6.23 Generation Relay",
  "non_goals": [
    "storage cleanup",
    "fleet behavior changes",
    "vessel feature changes",
    "staging remediation"
  ],
  "command_watchdog": {
    "ui_terminal_state_owner": "fleet-maintenance-index-watchdog",
    "automatic_storage_deadline_ms": 2500,
    "command_destination_deadline_ms": 1800,
    "storage_details_deadline_ms": 7000,
    "terminal_states": [
      "COMPLETE",
      "WATCH"
    ],
    "silent_failure": "forbidden",
    "independent_of_storage_promise": true
  }
}
